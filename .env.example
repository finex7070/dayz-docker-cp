# DayZ Server + Control Panel
# Copy to .env and fill in:  cp .env.example .env   (never commit .env)
#
# NOTE: comments always go on their own line. Docker Compose only strips a
# trailing "# ..." when the value is non-empty - on an empty value the comment
# itself becomes the value.

# === Panel =================================================================
# ADMIN_PASSWORD is required, the container refuses to start without it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PANEL_PORT=8080
SESSION_LIFETIME_HOURS=12

# Leave empty to generate one into /data/panel/secret_key.
PANEL_SECRET_KEY=

# Proxies whose X-Forwarded-* headers are accepted; IPs/CIDRs, comma separated.
# Empty = ignored. Behind Traefik etc. set e.g. 172.16.0.0/12, otherwise the
# panel sees the proxy as the client. "*" = trust any peer.
TRUSTED_PROXY_IPS=

# Secure flag on the session cookie: auto = only on HTTPS requests | true | false
SESSION_COOKIE_SECURE=auto

# Largest request body the panel accepts, in MB - the upload limit of the
# Files page. Raise it for large mission folders; a request above it is
# buffered to disk in the container first, so its real ceiling is free space
# there. Takes effect after a container recreate.
MAX_UPLOAD_MB=64


# === Steam =================================================================
# App 223350 is not downloadable anonymously - the account must own DayZ.
STEAM_USERNAME=
STEAM_PASSWORD=

# One-time code for the first login only (5 characters). Leave empty to enter
# it in the panel when SteamCMD asks.
STEAM_GUARD_CODE=

# Optional, only for the workshop search on the mods page
# (steamcommunity.com/dev/apikey). Installing by ID/URL works without it.
STEAM_API_KEY=


# === DayZ server ===========================================================
# SERVER_REAL_IP: public address players connect to, shown on the dashboard
# next to the port. Display only - the panel sees the container's private
# address, not the one the port is forwarded from. Empty hides it.
SERVER_REAL_IP=
# STEAM_QUERY_PORT is written into serverDZ.cfg before each start,
# RCON_PORT into beserver_x64.cfg.
SERVER_PORT=2302
STEAM_QUERY_PORT=27016
RCON_PORT=2305


# === Automation on container start =========================================
# AUTO_INSTALL: install server files if missing
# AUTO_START: start the server once installed
AUTO_INSTALL=true
AUTO_START=false


# === Container =============================================================
# PUID/PGID: host user owning the bind mount (`id -u`, `id -g`).
# Irrelevant on Docker Desktop. FIX_PERMS: auto | always (slow) | never
PUID=1000
PGID=1000
FIX_PERMS=auto
TZ=Europe/Berlin


# === Fine tuning (rarely needed) ===========================================
# PANEL_THREADS=16
# PANEL_TIMEOUT=120
# PANEL_LOG_LEVEL=info
